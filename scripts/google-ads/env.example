# Copie para scripts/google-ads/.env (gitignored via .env na raiz / local)
#
# Google Cloud → APIs & Services → Credentials (OAuth client Desktop ou Web)
# Redirect URI obrigatório para oauth-generate-refresh-token.mjs:
#   http://127.0.0.1:8721/oauth2callback
#
# Google Ads → Ferramentas → Centro da API → token de desenvolvedor

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# Conta ATLLY (sem hífens na API)
GOOGLE_ADS_CUSTOMER_ID=2442306941

# Opcional: ID do MCC se você acessa a ATLLY via manager account
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
