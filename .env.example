NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:5432/app_treino?schema=public"
# Neon (produção): use a connection string com sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
API_PORT=3333
WEB_ORIGIN="http://localhost:5174,http://localhost:5173,https://edersonprogramador.com,https://www.edersonprogramador.com"
PUBLIC_BASE_URL="http://localhost:3333"
# Produção (Render): PUBLIC_BASE_URL="https://api.edersonprogramador.com"
JWT_SECRET="change-me-in-local-development"
GOOGLE_CLIENT_ID=""
VITE_API_URL="http://localhost:3333"
# Produção (Vercel): VITE_API_URL="https://api.edersonprogramador.com"
VITE_GOOGLE_CLIENT_ID=""
# CDN de mídia (Cloudflare R2). Produção: https://media.edersonprogramador.com
VITE_MEDIA_URL=""
# Opcional: MapTiler (terrain RGB de maior qualidade no mapa 3D). Sem chave usa Terrarium AWS.
VITE_MAPTILER_KEY=""
ASAAS_API_KEY="sandbox-key"
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN="sandbox-webhook-token"
# Quando "true", o endpoint de confirmacao de pagamento aceita o ambiente Asaas sandbox (apenas dev).
ENABLE_SANDBOX_CONFIRM="false"
# Recuperação de senha (Resend): https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="App Treino <noreply@seudominio.com>"
# Cloudflare R2 (produção)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# E2E (Playwright) — aluno e admin de teste
E2E_STUDENT_EMAIL="teste@gmail.com"
E2E_STUDENT_PASSWORD="Teste@123"
E2E_ADMIN_EMAIL="admin@apptreino.com"
E2E_ADMIN_PASSWORD="Admin@123"
E2E_WEB_URL="http://localhost:5174"
E2E_API_URL="http://localhost:3333"
