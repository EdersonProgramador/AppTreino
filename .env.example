NODE_ENV="development"
DATABASE_URL="postgresql://user:password@localhost:5432/app_treino?schema=public"
# Neon (produção): use a connection string com sslmode=require
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
API_PORT=3333
WEB_ORIGIN="http://localhost:5174,http://localhost:5173,https://edersonprogramador.com,https://www.edersonprogramador.com"
PUBLIC_BASE_URL="http://localhost:3333"
# Produção (Render): PUBLIC_BASE_URL="https://api.edersonprogramador.com"
JWT_SECRET="change-me-in-local-development"
GOOGLE_CLIENT_ID=""
VITE_API_URL="http://localhost:3333"
# Produção (Vercel): VITE_API_URL="https://api.edersonprogramador.com"
VITE_GOOGLE_CLIENT_ID=""
# Google Maps JavaScript API (mapa de atividade na web — mesmo projeto do mobile)
VITE_GOOGLE_MAPS_API_KEY=""
# Opcional: Map ID (Cloud Console → Map Management) para vetor + prédios 3D
VITE_GOOGLE_MAPS_MAP_ID=""
# Mapbox (mapa web + Map Matching para encaixar o trajeto na via).
# Token público pk. em https://account.mapbox.com/access-tokens/ — ative Map Matching no token.
# Sem VITE_MAPBOX_ACCESS_TOKEN, o mapa web cai no Google e o finish não faz snap-to-road.
VITE_MAPBOX_ACCESS_TOKEN=""
# Opcional na API (sk. ou o mesmo pk.). Se vazio, a API reutiliza VITE_MAPBOX_ACCESS_TOKEN.
MAPBOX_ACCESS_TOKEN=""
# CDN de mídia (Cloudflare R2). Produção: mesmo valor em VITE_MEDIA_URL e EXPO_PUBLIC_MEDIA_URL
VITE_MEDIA_URL="https://pub-7bceff9c425e44b29161a5f8570c5266.r2.dev"
# Dados legais exibidos no site (footer e páginas /termos, /privacidade).
# Deixe vazio para ocultar CNPJ até a empresa estar regularizada.
VITE_LEGAL_COMPANY_NAME=""
VITE_LEGAL_CNPJ=""
VITE_LEGAL_CONTACT_EMAIL="contato@atlly.com.br"
VITE_LEGAL_DPO_EMAIL="privacidade@atlly.com.br"
ASAAS_API_KEY="sandbox-key"
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN="sandbox-webhook-token"
# URL pública do app (retorno do checkout Asaas: vitrine → Meus pedidos / Carrinho)
ASAAS_CALLBACK_URL="http://localhost:5173"
# Melhor Envio (Correios/JadLog via API). Sandbox: https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
# Quando "true", o endpoint de confirmacao de pagamento aceita o ambiente Asaas sandbox (apenas dev).
ENABLE_SANDBOX_CONFIRM="false"
# Recuperação de senha (Resend): https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="App Treino <noreply@seudominio.com>"
# Cloudflare R2 (produção)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# E2E (Playwright) — aluno e admin de teste
E2E_STUDENT_EMAIL="teste@gmail.com"
E2E_STUDENT_PASSWORD="Teste@123"
E2E_ADMIN_EMAIL="admin@apptreino.com"
E2E_ADMIN_PASSWORD="Admin@123"
E2E_WEB_URL="http://localhost:5174"
E2E_API_URL="http://localhost:3333"
# Coach IA. Sem LLM, o especialista local monta treino + dieta por biotipo.
# Padrão: auto — Ollama (Llama) se OLLAMA_API_KEY / OLLAMA_HOST existir; senão OpenAI.
# LLM_PROVIDER="auto"
# LLM_PROVIDER="ollama"
# LLM_PROVIDER="openai"
#
# Ollama Cloud (Llama na nuvem): crie a chave em https://ollama.com/settings/keys
# OLLAMA_API_KEY=""
# OLLAMA_BASE_URL="https://ollama.com/v1"
# OLLAMA_MODEL="gpt-oss:20b"
#
# Ollama local: ollama pull llama3.1
# OLLAMA_HOST="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.1"
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
#
# OpenAI (chat fallback + Whisper de voz)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
