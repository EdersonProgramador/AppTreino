{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace=@app-treino/shared && npm run build --workspace=@app-treino/web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/public/share/:path*",
      "destination": "https://api.atlly.com.br/public/share/:path*"
    },
    {
      "source": "/public/posts/:path*",
      "destination": "https://api.atlly.com.br/public/posts/:path*"
    },
    {
      "source": "/((?!assets/|activity-map\\.html|activity-map-google\\.html|live-room\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
