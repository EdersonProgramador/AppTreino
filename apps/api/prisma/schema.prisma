  name       String
  stateCode  String?   @map("state_code")
  postalFrom String?   @map("postal_from")
  postalTo   String?   @map("postal_to")
  feeInCents Int       @map("fee_in_cents")
  priority   Int       @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("shipping_zones")
}

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  couponCode String?  @map("coupon_code")
  fulfillmentMethod ShippingMethod? @map("fulfillment_method")
  destinationPostalCode String? @map("destination_postal_code")
  destinationStreet String? @map("destination_street")
  destinationNumber String? @map("destination_number")
  destinationComplement String? @map("destination_complement")
  destinationNeighborhood String? @map("destination_neighborhood")
  destinationCity String? @map("destination_city")
  destinationState String? @map("destination_state")
  shippingCarrier String? @map("shipping_carrier")
  shippingServiceId String? @map("shipping_service_id")
  shippingServiceName String? @map("shipping_service_name")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

