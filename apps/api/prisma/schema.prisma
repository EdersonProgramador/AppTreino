enum MusicPublishStatus {
  DRAFT
  PUBLISHED
}

model MusicAlbum {
  id          String             @id @default(cuid())
  title       String
  description String?
  coverUrl    String?            @map("cover_url")
  status      MusicPublishStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tracks      MusicTrack[]

  @@index([status, publishedAt])
  @@map("music_albums")
}

model MusicTrack {
  id          String             @id @default(cuid())
  albumId     String?            @map("album_id")
  album       MusicAlbum?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  title       String
  artist      String?
  audioUrl    String             @map("audio_url")
  coverUrl    String?            @map("cover_url")
  durationSec Int?               @map("duration_sec")
  sortOrder   Int                @default(0) @map("sort_order")
  status      MusicPublishStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([albumId, sortOrder])
  @@index([status, publishedAt])
  @@map("music_tracks")
}

/// Cada vez que o aluno conclui a sequência completa de um treino (inclusive repetições).
model ProgramCycleCompletion {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  programId    String   @map("program_id")
  modalityId   String?  @map("modality_id")
  modalityName String   @map("modality_name")
  programTitle String   @map("program_title")
  cycleNumber  Int      @map("cycle_number")
  completedAt  DateTime @default(now()) @map("completed_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId, programId])
  @@index([userId, modalityId])
  @@map("program_cycle_completions")
}

/// Selo de conquista no perfil: uma medalha por modalidade, com contagem de ciclos.
model ModalityAchievement {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  modalityId      String    @map("modality_id")
  modalityName    String    @map("modality_name")
  completionCount Int       @default(1) @map("completion_count")
  lastCompletedAt DateTime  @map("last_completed_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  modality        Modality  @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@unique([userId, modalityId])
  @@index([userId, lastCompletedAt])
  @@map("modality_achievements")
}

/// Conquistas de atividade outdoor (distância, streak, desafio).
model UserActivityAchievement {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  category    String
  value       Float?
  earnedAt    DateTime @default(now()) @map("earned_at")

  @@unique([userId, slug])
  @@index([userId, earnedAt])
  @@map("user_activity_achievements")
}

/// Inbox individual de notificações por aluno (login).
model StudentNotification {
  id            String    @id @default(cuid())
