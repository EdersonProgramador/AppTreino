generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String?              @unique
  phone               String?              @unique
  passwordHash        String?              @map("password_hash")
  provider            String               @default("EMAIL")
  googleId            String?              @unique @map("google_id")
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  enrollmentStatus    EnrollmentStatus     @default(PENDING) @map("enrollment_status")
  profile             Profile?
  memberships         Membership[]
  enrollments         Enrollment[]
  programAssignments  UserProgram[]
  workoutSessions     WorkoutSession[]
  attendances         AttendanceRecord[]
  physicalAssessments PhysicalAssessment[]
  eventRegistrations  EventRegistration[]
  supportTickets      SupportTicket[]      @relation("SupportTicketStudent")
  assignedTickets     SupportTicket[]      @relation("SupportTicketAssignee")
  aiWorkoutPlans      AiWorkoutPlan[]
  userProgress        UserProgress[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(PENDING)
  planType  String           @map("plan_type")
  asaasId   String?          @unique @map("asaas_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("enrollments")
}

model Profile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  phone     String?
  document  String?
  birthDate DateTime? @map("birth_date")
  objective String?
  level     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  priceInCents Int          @map("price_in_cents")
  billingCycle BillingCycle @map("billing_cycle")
  memberships  Membership[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("plans")
}

model Membership {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  planId    String           @map("plan_id")
  user      User             @relation(fields: [userId], references: [id])
  plan      Plan             @relation(fields: [planId], references: [id])
  status    MembershipStatus @default(PENDING)
  startsAt  DateTime         @map("starts_at")
  endsAt    DateTime?        @map("ends_at")
  payments  Payment[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("memberships")
}

model Payment {
  id             String        @id @default(cuid())
  membershipId   String        @map("membership_id")
  membership     Membership    @relation(fields: [membershipId], references: [id])
  amountInCents  Int           @map("amount_in_cents")
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  asaasPaymentId String?       @unique @map("asaas_payment_id")
  paymentUrl     String?       @map("payment_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Workout {
  id        String       @id @default(cuid())
  title     String
  objective String?
  days      WorkoutDay[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("workouts")
}

model WorkoutDay {
  id        String     @id @default(cuid())
  workoutId String     @map("workout_id")
  workout   Workout    @relation(fields: [workoutId], references: [id])
  title     String
  sortOrder Int        @map("sort_order")
  exercises Exercise[]

  @@map("workout_days")
}

model Exercise {
  id               String                 @id @default(cuid())
  workoutDayId     String?                @map("workout_day_id")
  workoutDay       WorkoutDay?            @relation(fields: [workoutDayId], references: [id])
  name             String?
  title            String?
  videoUrl         String?                @map("video_url")
  audioUrl         String?                @map("audio_url")
  targetMuscles    String[]               @default([]) @map("target_muscles")
  equipmentTags    String[]               @default([]) @map("equipment_tags")
  alternatives     Exercise[]             @relation("ExerciseAlternatives")
  alternativeTo    Exercise[]             @relation("ExerciseAlternatives")
  workoutExercises WorkoutBlockExercise[]
  userProgress     UserProgress[]
  sets             Int?
  reps             String?
  restSeconds      Int?                   @map("rest_seconds")
  notes            String?
  sortOrder        Int?                   @map("sort_order")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@map("exercises")
}

model WorkoutBlock {
  id              String                 @id @default(cuid())
  title           String
  structureType   StructureType          @default(NORMAL) @map("structure_type")
  restTime        Int                    @map("rest_time")
  createdAt       DateTime               @default(now()) @map("created_at")
  exercises       WorkoutBlockExercise[]
  programDays     ProgramDayWorkout[]
  workoutSessions WorkoutSession[]

  @@map("workout_blocks")
}

model WorkoutBlockExercise {
  id             String       @id @default(cuid())
  workoutBlockId String       @map("workout_block_id")
  exerciseId     String       @map("exercise_id")
  workoutBlock   WorkoutBlock @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets           Int
  repsRange      String       @map("reps_range")
  order          Int

  @@map("workout_block_exercises")
}

model Program {
  id              String              @id @default(cuid())
  title           String
  description     String
  status          ProgramStatus       @default(DRAFT)
  isActive        Boolean             @default(true) @map("is_active")
  publishedAt     DateTime?           @map("published_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  days            ProgramDayWorkout[]
  assignedUsers   UserProgram[]
  workoutSessions WorkoutSession[]

  @@map("programs")
}

model UserProgram {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  programId       String            @map("program_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  status          UserProgramStatus @default(ACTIVE)
  currentDay      Int               @default(1) @map("current_day")
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  workoutSessions WorkoutSession[]

  @@unique([userId, programId])
  @@map("user_programs")
}

model ProgramDayWorkout {
  id             String       @id @default(cuid())
  programId      String       @map("program_id")
  workoutBlockId String       @map("workout_block_id")
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutBlock   WorkoutBlock @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
  dayNumber      Int          @map("day_number")
  order          Int

  @@map("program_day_workouts")
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  exerciseId    String   @map("exercise_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  weightUsed    Float    @map("weight_used")
  repsCompleted Int      @map("reps_completed")
  seriesIndex   Int      @map("series_index")
  completedAt   DateTime @default(now()) @map("completed_at")

  @@map("user_progress")
}

model WorkoutSession {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  assignmentId    String?              @map("assignment_id")
  programId       String?              @map("program_id")
  workoutBlockId  String?              @map("workout_block_id")
  dayNumber       Int                  @map("day_number")
  startedAt       DateTime             @default(now()) @map("started_at")
  finishedAt      DateTime?            @map("finished_at")
  durationSeconds Int?                 @map("duration_seconds")
  status          WorkoutSessionStatus @default(IN_PROGRESS)
  createdAt       DateTime             @default(now()) @map("created_at")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment      UserProgram?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  program         Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  workoutBlock    WorkoutBlock?        @relation(fields: [workoutBlockId], references: [id], onDelete: SetNull)

  @@map("workout_sessions")
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("attendance_records")
}

model PhysicalAssessment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  assessedAt DateTime @map("assessed_at")
  weightKg   Float?   @map("weight_kg")
  heightCm   Float?   @map("height_cm")
  bodyFatPct Float?   @map("body_fat_pct")
  waistCm    Float?   @map("waist_cm")
  chestCm    Float?   @map("chest_cm")
  hipCm      Float?   @map("hip_cm")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("physical_assessments")
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime?           @map("ends_at")
  location      String?
  capacity      Int?
  status        EventStatus         @default(SCHEDULED)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model SupportTicket {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  assignedToId String?        @map("assigned_to_id")
  user         User           @relation("SupportTicketStudent", fields: [userId], references: [id])
  assignedTo   User?          @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  subject      String
  message      String
  category     TicketCategory @default(GENERAL)
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model AiWorkoutPlan {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  objective   String
  level       String
  daysPerWeek Int      @map("days_per_week")
  focus       String?
  plan        Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_workout_plans")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  OVERDUE
  CANCELED

  @@map("membership_status")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  CANCELED

  @@map("enrollment_status")
}

enum StructureType {
  NORMAL
  BI_SET
  DROP_SET
  REST_PAUSE

  @@map("structure_type")
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("program_status")
}

enum UserProgramStatus {
  ACTIVE
  COMPLETED
  CANCELED

  @@map("user_program_status")
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED

  @@map("workout_session_status")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELED

  @@map("payment_status")
}

enum EventStatus {
  SCHEDULED
  CANCELED
  FINISHED

  @@map("event_status")
}

enum TicketCategory {
  GENERAL
  WORKOUT
  PAYMENT
  TECHNICAL

  @@map("ticket_category")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH

  @@map("ticket_priority")
}
