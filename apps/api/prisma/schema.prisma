model Product {
  id             String         @id @default(cuid())
  name           String
  description    String?
  priceInCents   Int            @default(0) @map("price_in_cents")
  imageUrl       String?        @map("image_url")
  category       String?
  kind           ProductKind    @default(PHYSICAL)
  /// Definido pelo admin: PICKUP/DELIVERY para físico; DIGITAL para digital.
  shippingMethod ShippingMethod @default(PICKUP) @map("shipping_method")
  allowsPickup   Boolean        @default(true) @map("allows_pickup")
  allowsDelivery Boolean        @default(true) @map("allows_delivery")
  shippingFeeInCents Int?       @map("shipping_fee_in_cents")
  weightGrams    Int            @default(300) @map("weight_grams")
  lengthCm       Int            @default(20) @map("length_cm")
  widthCm        Int            @default(15) @map("width_cm")
  heightCm       Int            @default(10) @map("height_cm")
  stock          Int?
  isActive       Boolean        @default(true) @map("is_active")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  purchases Purchase[]
  cartItems CartItem[]
  orderItems OrderItem[]
  favorites Favorite[]
  ratings   Rating[]

  @@map("products")
}

enum ProductKind {
  PHYSICAL
  DIGITAL

  @@map("product_kind")
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  READY
  DELIVERED
  CANCELED
  REFUNDED

  @@map("purchase_status")
}

model Purchase {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  productId      String         @map("product_id")
  amountInCents  Int            @map("amount_in_cents")
  quantity       Int            @default(1)
  status         PurchaseStatus @default(PENDING)
  shippingInCents Int           @default(0) @map("shipping_in_cents")
  shippingMethod ShippingMethod @default(PICKUP) @map("shipping_method")
  shippingAddress String?       @map("shipping_address")
  destinationPostalCode String?  @map("destination_postal_code")
  destinationStreet String?    @map("destination_street")
  destinationNumber String?    @map("destination_number")
  destinationComplement String? @map("destination_complement")
  destinationNeighborhood String? @map("destination_neighborhood")
  destinationCity String?        @map("destination_city")
  destinationState String?       @map("destination_state")
  shippingCarrier String?       @map("shipping_carrier")
  shippingServiceId String?     @map("shipping_service_id")
  shippingServiceName String?   @map("shipping_service_name")
  shippingQuoteSource String?   @map("shipping_quote_source")
  paymentMethod  String?        @map("payment_method")
  notes          String?
  asaasPaymentId String?        @unique @map("asaas_payment_id")
  paymentUrl     String?        @map("payment_url")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  paidAt         DateTime?      @map("paid_at")
  fulfilledAt    DateTime?      @map("fulfilled_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([productId, status])
  @@map("purchases")
}

enum OrderStatus {
