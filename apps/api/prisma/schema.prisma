generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String?              @unique
  phone               String?              @unique
  passwordHash        String?              @map("password_hash")
  provider            String               @default("EMAIL")
  googleId            String?              @unique @map("google_id")
  role                UserRole             @default(USER)
  status              UserStatus           @default(ACTIVE)
  enrollmentStatus    EnrollmentStatus     @default(PENDING) @map("enrollment_status")
  deletedAt           DateTime?            @map("deleted_at")
  profile             Profile?
  memberships         Membership[]
  enrollments         Enrollment[]
  programAssignments  UserProgram[]
  workoutSessions     WorkoutSession[]
  attendances         AttendanceRecord[]
  physicalAssessments PhysicalAssessment[]
  eventRegistrations  EventRegistration[]
  supportTickets      SupportTicket[]      @relation("SupportTicketStudent")
  assignedTickets     SupportTicket[]      @relation("SupportTicketAssignee")
  aiWorkoutPlans      AiWorkoutPlan[]
  coachMemories       CoachMemory[]
  coachAgentRuns      CoachAgentRun[]
  userProgress        UserProgress[]
  purchases           Purchase[]
  cart                Cart?
  orders              Order[]
  paymentCards        PaymentCard[]
  favorites           Favorite[]
  workoutFavorites    WorkoutFavorite[]
  ratings             Rating[]
  passwordResetTokens PasswordResetToken[]
  notifications             StudentNotification[]
  programCycleCompletions   ProgramCycleCompletion[]
  modalityAchievements      ModalityAchievement[]
  activityAchievements      UserActivityAchievement[]
  socialPosts               SocialPost[]
  socialLikes               SocialLike[]
  socialDislikes            SocialDislike[]
  socialComments            SocialComment[]
  socialCommentLikes        SocialCommentLike[]
  socialReports             SocialReport[]
  socialFollowing           SocialFollow[]         @relation("SocialFollowFrom")
  socialFollowers           SocialFollow[]         @relation("SocialFollowTo")
  socialStories             SocialStory[]
  socialStoryViews          SocialStoryView[]
  socialStoryGallery        SocialStoryGallery[]
  socialReels               SocialReel[]
  socialReelLikes           SocialReelLike[]
  socialLiveSessions        SocialLiveSession[]
  socialLiveMessages        SocialLiveMessage[]
  socialLiveSaves           SocialLiveSave[]
  socialConversationsA      SocialConversation[]   @relation("SocialConversationA")
  socialConversationsB      SocialConversation[]   @relation("SocialConversationB")
  socialDirectMessages      SocialDirectMessage[]
  socialGlobalMessages      SocialGlobalMessage[]
  socialFollowRequestsFrom  SocialFollowRequest[]  @relation("SocialFollowRequestFrom")
  socialFollowRequestsTo    SocialFollowRequest[]  @relation("SocialFollowRequestTo")
  socialBlocksFrom          SocialBlock[]          @relation("SocialBlocker")
  socialBlocksTo            SocialBlock[]          @relation("SocialBlocked")
  outdoorActivities         OutdoorActivity[]
  outdoorActivityCells      OutdoorActivityCell[]
  outdoorSegmentEfforts     OutdoorSegmentEffort[]
  clubMemberships           ClubMembership[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(PENDING)
  planType  String           @map("plan_type")
  asaasId   String?          @unique @map("asaas_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("enrollments")
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  phone          String?
  document       String?
  gender         Gender?
  birthDate      DateTime? @map("birth_date")
  objective      String?
  level          String?
  daysPerWeek    Int?      @map("days_per_week")
  equipmentTags  String[]  @default([]) @map("equipment_tags")
  city           String?
  state          String?
  avatarUrl      String?   @map("avatar_url")
  /// Conta privada: follow vira pedido.
  isPrivate      Boolean   @default(false) @map("is_private")
  /// Bio pública do atleta (perfil social).
  bio            String?
  /// Cor de capa do perfil social (hex).
  coverColor     String?   @map("cover_color")
  /// Imagem de capa do perfil social (URL).
  coverUrl       String?   @map("cover_url")
  locationId     String?   @map("location_id")
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  priceInCents Int          @map("price_in_cents")
  billingCycle BillingCycle @map("billing_cycle")
  deletedAt    DateTime?    @map("deleted_at")
  memberships  Membership[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("plans")
}

model Membership {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  planId    String           @map("plan_id")
  user      User             @relation(fields: [userId], references: [id])
  plan      Plan             @relation(fields: [planId], references: [id])
  status    MembershipStatus @default(PENDING)
  startsAt  DateTime         @map("starts_at")
  endsAt    DateTime?        @map("ends_at")
  deletedAt DateTime?        @map("deleted_at")
  payments  Payment[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status])
  @@map("memberships")
}

model Payment {
  id             String        @id @default(cuid())
  membershipId   String        @map("membership_id")
  membership     Membership    @relation(fields: [membershipId], references: [id])
  amountInCents  Int           @map("amount_in_cents")
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  asaasPaymentId String?       @unique @map("asaas_payment_id")
  paymentUrl     String?       @map("payment_url")
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([membershipId])
  @@map("payments")
}

model Workout {
  id        String       @id @default(cuid())
  title     String
  objective String?
  deletedAt DateTime?    @map("deleted_at")
  days      WorkoutDay[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("workouts")
}

model WorkoutDay {
  id        String     @id @default(cuid())
  workoutId String     @map("workout_id")
  workout   Workout    @relation(fields: [workoutId], references: [id])
  title     String
  sortOrder Int        @map("sort_order")
  exercises Exercise[]

  @@map("workout_days")
}

model Exercise {
  id               String                 @id @default(cuid())
  workoutDayId     String?                @map("workout_day_id")
  workoutDay       WorkoutDay?            @relation(fields: [workoutDayId], references: [id])
  name             String?
  title            String?
  videoUrl         String?                @map("video_url")
  audioUrl         String?                @map("audio_url")
  materialUrl      String?                @map("material_url")
  targetMuscles    String[]               @default([]) @map("target_muscles")
  equipmentTags    String[]               @default([]) @map("equipment_tags")
  alternatives     Exercise[]             @relation("ExerciseAlternatives")
  alternativeTo    Exercise[]             @relation("ExerciseAlternatives")
  workoutExercises WorkoutBlockExercise[]
  modalityLinks    ExerciseModality[]
  userProgress     UserProgress[]
  sets             Int?
  reps             String?
  restSeconds      Int?                   @map("rest_seconds")
  notes            String?
  sortOrder        Int?                   @map("sort_order")
  deletedAt        DateTime?              @map("deleted_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@map("exercises")
}

model Modality {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  description   String?
  icon          String?
  imageUrl      String?            @map("image_url")
  type          String             @default("EXERCISE")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @default(0) @map("sort_order")
  programs      Program[]
  exerciseLinks ExerciseModality[]
  workoutBlocks WorkoutBlock[]
  achievements  ModalityAchievement[]
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("modalities")
}

model ExerciseModality {
  id         String   @id @default(cuid())
  exerciseId String   @map("exercise_id")
  modalityId String   @map("modality_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  modality   Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  principal  Boolean  @default(false)

  @@unique([exerciseId, modalityId])
  @@map("exercise_modalities")
}

model WorkoutBlock {
  id              String                 @id @default(cuid())
  title           String
  identifier      String?
  focus           String?
  weeklyFrequency Int                    @default(1) @map("weekly_frequency")
  structureType   StructureType          @default(NORMAL) @map("structure_type")
  restTime        Int                    @map("rest_time")
  protocolRounds  Int?                   @map("protocol_rounds")
  workSeconds     Int?                   @map("work_seconds")
  timeCapSeconds  Int?                   @map("time_cap_seconds")
  instructions    String?
  modalityId      String?                @map("modality_id")
  modality        Modality?              @relation(fields: [modalityId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?              @map("deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  exercises       WorkoutBlockExercise[]
  programDays     ProgramDayWorkout[]
  workoutSessions WorkoutSession[]

  @@map("workout_blocks")
}

model WorkoutBlockExercise {
  id                 String           @id @default(cuid())
  workoutBlockId     String           @map("workout_block_id")
  exerciseId         String           @map("exercise_id")
  workoutBlock       WorkoutBlock     @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
  exercise           Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets               Int
  repsRange          String           @map("reps_range")
  prescriptionType   PrescriptionType @default(REPETITIONS) @map("prescription_type")
  repsMin            Int?             @map("reps_min")
  repsMax            Int?             @map("reps_max")
  durationSeconds    Int?             @map("duration_seconds")
  distanceMeters     Float?           @map("distance_meters")
  rounds             Int?
  workSeconds        Int?             @map("work_seconds")
  intensityType      IntensityType    @default(NONE) @map("intensity_type")
  intensityValue     String?          @map("intensity_value")
  tempo              String?
  side               String?
  executionNotes     String?          @map("execution_notes")
  initialLoad        String?          @map("initial_load")
  restSeconds        Int?             @map("rest_seconds")
  supportMaterialUrl String?          @map("support_material_url")
  order              Int
  userProgress       UserProgress[]

  @@map("workout_block_exercises")
}

model Program {
  id                String                @id @default(cuid())
  modalityId        String?               @map("modality_id")
  modality          Modality?             @relation(fields: [modalityId], references: [id], onDelete: SetNull)
  title             String
  description       String
  durationYears     Int                   @default(0) @map("duration_years")
  durationMonths    Int                   @default(0) @map("duration_months")
  durationWeeks     Int                   @default(4) @map("duration_weeks")
  durationDays      Int                   @default(28) @map("duration_days")
  durationExtraDays Int                   @default(0) @map("duration_extra_days")
  plannedSessions   Int                   @default(12) @map("planned_sessions")
  completionMode    ProgramCompletionMode @default(BY_SESSIONS) @map("completion_mode")
  scheduleType      ProgramScheduleType   @default(ROTATING_CYCLE) @map("schedule_type")
  audienceMode      ProgramAudienceMode   @default(ALL_ACTIVE) @map("audience_mode")
  cycleLengthDays   Int                   @default(7) @map("cycle_length_days")
  targetGender      ProgramTargetGender   @default(ALL) @map("target_gender")
  totalWorkouts     Int                   @default(30) @map("total_workouts")
  status            ProgramStatus         @default(DRAFT)
  isActive          Boolean               @default(true) @map("is_active")
  sortOrder         Int                   @default(1) @map("sort_order")
  deletedAt         DateTime?             @map("deleted_at")
  publishedAt       DateTime?             @map("published_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  days              ProgramDayWorkout[]
  assignedUsers     UserProgram[]
  workoutSessions   WorkoutSession[]
  favorites         WorkoutFavorite[]
  cycleCompletions  ProgramCycleCompletion[]

  @@index([status, isActive, deletedAt])
  @@index([modalityId])
  @@map("programs")
}

model UserProgram {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  programId         String            @map("program_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program           Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  status            UserProgramStatus @default(ACTIVE)
  currentDay        Int               @default(1) @map("current_day")
  totalWorkouts     Int               @default(30) @map("total_workouts")
  completedWorkouts Int               @default(0) @map("completed_workouts")
  startedAt         DateTime          @default(now()) @map("started_at")
  plannedEndsAt     DateTime?         @map("planned_ends_at")
  completedAt       DateTime?         @map("completed_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  workoutSessions   WorkoutSession[]

  @@unique([userId, programId])
  @@map("user_programs")
}

model ProgramDayWorkout {
  id             String       @id @default(cuid())
  programId      String       @map("program_id")
  workoutBlockId String       @map("workout_block_id")
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutBlock   WorkoutBlock @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
  dayNumber      Int          @map("day_number")
  order          Int

  @@index([programId])
  @@map("program_day_workouts")
}

model UserProgress {
  id                     String                @id @default(cuid())
  userId                 String                @map("user_id")
  exerciseId             String                @map("exercise_id")
  sessionId              String?               @map("session_id")
  workoutBlockExerciseId String?               @map("workout_block_exercise_id")
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise               Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  session                WorkoutSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  workoutBlockExercise   WorkoutBlockExercise? @relation(fields: [workoutBlockExerciseId], references: [id], onDelete: SetNull)
  weightUsed             Float                 @map("weight_used")
  repsCompleted          Int                   @map("reps_completed")
  durationSeconds        Int?                  @map("duration_seconds")
  distanceMeters         Float?                @map("distance_meters")
  roundsCompleted        Int?                  @map("rounds_completed")
  perceivedExertion      Float?                @map("perceived_exertion")
  notes                  String?
  seriesIndex            Int                   @map("series_index")
  completedAt            DateTime              @default(now()) @map("completed_at")

  @@index([sessionId, workoutBlockExerciseId])
  @@map("user_progress")
}

model WorkoutSession {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  assignmentId     String?              @map("assignment_id")
  programId        String?              @map("program_id")
  workoutBlockId   String?              @map("workout_block_id")
  dayNumber        Int                  @map("day_number")
  startedAt        DateTime             @default(now()) @map("started_at")
  finishedAt       DateTime?            @map("finished_at")
  durationSeconds  Int?                 @map("duration_seconds")
  status           WorkoutSessionStatus @default(IN_PROGRESS)
  createdAt        DateTime             @default(now()) @map("created_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment       UserProgram?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  program          Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  workoutBlock     WorkoutBlock?        @relation(fields: [workoutBlockId], references: [id], onDelete: SetNull)
  exerciseProgress UserProgress[]
  socialPost       SocialPost?

  @@index([userId])
  @@map("workout_sessions")
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("attendance_records")
}

model PhysicalAssessment {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  assessedAt DateTime  @map("assessed_at")
  weightKg   Float?    @map("weight_kg")
  heightCm   Float?    @map("height_cm")
  bodyFatPct Float?    @map("body_fat_pct")
  waistCm    Float?    @map("waist_cm")
  chestCm    Float?    @map("chest_cm")
  hipCm      Float?    @map("hip_cm")
  notes      String?
  source     String    @default("STUDENT")
  details    Json?
  deletedAt  DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("physical_assessments")
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime?           @map("ends_at")
  location      String?
  capacity      Int?
  status        EventStatus         @default(SCHEDULED)
  registrations EventRegistration[]
  deletedAt     DateTime?           @map("deleted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

model SupportTicket {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  assignedToId String?         @map("assigned_to_id")
  user         User            @relation("SupportTicketStudent", fields: [userId], references: [id])
  assignedTo   User?           @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  subject      String
  message      String
  category     TicketCategory  @default(GENERAL)
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  deletedAt    DateTime?       @map("deleted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  messages     TicketMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String        @map("ticket_id")
  senderId   String?       @map("sender_id")
  senderType String        @map("sender_type")
  body       String
  createdAt  DateTime      @default(now()) @map("created_at")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model AiWorkoutPlan {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  objective   String
  level       String
  daysPerWeek Int       @map("days_per_week")
  focus       String?
  plan        Json
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("ai_workout_plans")
}

enum CoachMemoryKind {
  LONG_TERM
  EPISODIC
  CONTEXTUAL
  GLOBAL

  @@map("coach_memory_kind")
}

/// Memória do Coach: longa (preferências), episódica (turnos), contextual (pedido) e coletiva (global).
model CoachMemory {
  id        String          @id @default(cuid())
  userId    String?         @map("user_id")
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      CoachMemoryKind
  content   String
  embedding Json?
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([userId, kind, createdAt])
  @@index([kind, createdAt])
  @@map("coach_memories")
}

/// Auditoria do loop percepção → raciocínio → ação → feedback.
model CoachAgentRun {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentKind    String   @map("agent_kind")
  pattern      String
  perception   Json
  traces       Json
  actions      Json
  feedback     Json?
  iterations   Int      @default(1)
  toolCalls    Int      @default(0)
  blocked      Boolean  @default(false)
  blockReason  String?  @map("block_reason")
  replyPreview String?  @map("reply_preview")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("coach_agent_runs")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  OVERDUE
  CANCELED

  @@map("membership_status")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  CANCELED

  @@map("enrollment_status")
}

enum StructureType {
  NORMAL
  BI_SET
  DROP_SET
  REST_PAUSE
  CIRCUIT
  AMRAP
  EMOM
  FOR_TIME
  TABATA
  INTERVAL
  CLASS

  @@map("structure_type")
}

enum PrescriptionType {
  REPETITIONS
  DURATION
  DISTANCE
  INTERVAL
  ROUNDS
  HOLD
  FREE

  @@map("prescription_type")
}

enum IntensityType {
  NONE
  LOAD
  RPE
  RIR
  PERCENT_1RM
  HEART_RATE_ZONE
  PACE
  SPEED

  @@map("intensity_type")
}

enum ProgramCompletionMode {
  BY_SESSIONS
  BY_DATE
  BOTH
  MANUAL

  @@map("program_completion_mode")
}

enum ProgramScheduleType {
  ROTATING_CYCLE
  WEEKLY
  ON_DEMAND

  @@map("program_schedule_type")
}

enum ProgramAudienceMode {
  ALL_ACTIVE
  SELECTED

  @@map("program_audience_mode")
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("program_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum ProgramTargetGender {
  ALL
  MALE
  FEMALE

  @@map("program_target_gender")
}

enum UserProgramStatus {
  ACTIVE
  COMPLETED
  CANCELED

  @@map("user_program_status")
}

enum WorkoutSessionStatus {
  IN_PROGRESS
