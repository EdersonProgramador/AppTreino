generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String?               @unique
  phone                 String?               @unique
  passwordHash          String?               @map("password_hash")
  provider              String                @default("EMAIL")
  googleId              String?               @unique @map("google_id")
  role                  UserRole              @default(USER)
  status                UserStatus            @default(ACTIVE)
  profile               Profile?
  memberships           Membership[]
  attendances           AttendanceRecord[]
  physicalAssessments   PhysicalAssessment[]
  eventRegistrations    EventRegistration[]
  supportTickets        SupportTicket[]       @relation("SupportTicketStudent")
  assignedTickets       SupportTicket[]       @relation("SupportTicketAssignee")
  aiWorkoutPlans        AiWorkoutPlan[]
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  phone       String?
  document    String?
  birthDate   DateTime? @map("birth_date")
  objective   String?
  level       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Plan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  priceInCents Int        @map("price_in_cents")
  billingCycle BillingCycle @map("billing_cycle")
  memberships Membership[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("plans")
}

model Membership {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  planId      String           @map("plan_id")
  user        User             @relation(fields: [userId], references: [id])
  plan        Plan             @relation(fields: [planId], references: [id])
  status      MembershipStatus @default(PENDING)
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  payments    Payment[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("memberships")
}

model Payment {
  id              String        @id @default(cuid())
  membershipId    String        @map("membership_id")
  membership      Membership    @relation(fields: [membershipId], references: [id])
  amountInCents   Int           @map("amount_in_cents")
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  asaasPaymentId  String?       @unique @map("asaas_payment_id")
  paymentUrl      String?       @map("payment_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Workout {
  id          String       @id @default(cuid())
  title       String
  objective   String?
  days        WorkoutDay[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("workouts")
}

model WorkoutDay {
  id          String     @id @default(cuid())
  workoutId   String     @map("workout_id")
  workout     Workout    @relation(fields: [workoutId], references: [id])
  title       String
  sortOrder   Int        @map("sort_order")
  exercises   Exercise[]

  @@map("workout_days")
}

model Exercise {
  id          String     @id @default(cuid())
  workoutDayId String    @map("workout_day_id")
  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id])
  name        String
  sets        Int
  reps        String
  restSeconds Int?       @map("rest_seconds")
  notes       String?
  sortOrder   Int        @map("sort_order")

  @@map("exercises")
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("attendance_records")
}

model PhysicalAssessment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  assessedAt  DateTime @map("assessed_at")
  weightKg    Float?   @map("weight_kg")
  heightCm    Float?   @map("height_cm")
  bodyFatPct  Float?   @map("body_fat_pct")
  waistCm     Float?   @map("waist_cm")
  chestCm     Float?   @map("chest_cm")
  hipCm       Float?   @map("hip_cm")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("physical_assessments")
}

model Event {
  id          String              @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime            @map("starts_at")
  endsAt      DateTime?           @map("ends_at")
  location    String?
  capacity    Int?
  status      EventStatus         @default(SCHEDULED)
  registrations EventRegistration[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model SupportTicket {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  assignedToId String?      @map("assigned_to_id")
  user        User          @relation("SupportTicketStudent", fields: [userId], references: [id])
  assignedTo  User?         @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  subject     String
  message     String
  category    TicketCategory @default(GENERAL)
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model AiWorkoutPlan {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  objective   String
  level       String
  daysPerWeek Int      @map("days_per_week")
  focus       String?
  plan        Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_workout_plans")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  OVERDUE
  CANCELED

  @@map("membership_status")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELED

  @@map("payment_status")
}

enum EventStatus {
  SCHEDULED
  CANCELED
  FINISHED

  @@map("event_status")
}

enum TicketCategory {
  GENERAL
  WORKOUT
  PAYMENT
  TECHNICAL

  @@map("ticket_category")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH

  @@map("ticket_priority")
}
