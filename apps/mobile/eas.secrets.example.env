# Copie valores reais para secrets do EAS (não commite este arquivo preenchido):
#   eas secret:create --scope project --name EXPO_PUBLIC_REVENUECAT_IOS_API_KEY --value "appl_..."
#   eas secret:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value "AIza..."
#   eas secret:create --scope project --name EXPO_PUBLIC_MEDIA_URL --value "https://..."
#
# Variáveis já definidas em eas.json → build.production.env:
#   APP_ENV=production
#   EXPO_PUBLIC_API_URL=https://api.atlly.com.br
#   EXPO_PUBLIC_WEB_URL=https://atlly.com.br
#
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MEDIA_URL=
