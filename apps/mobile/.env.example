# Base URL of the web app: used for deep link prefixes and the admin panel link.
# Leave unset in LAN tests: the app uses the same IP as the Expo QR (port 5174).
# EXPO_PUBLIC_WEB_URL=https://app-treino-api.vercel.app

# Optional override (stale LAN IPs are rewritten to the Expo host automatically):
# EXPO_PUBLIC_WEB_URL=http://192.168.1.7:5174

# API used by the native login screen. LAN defaults to Expo host :3333 when the web URL is LAN.
# EXPO_PUBLIC_API_URL=https://apptreino-backend.onrender.com
# EXPO_PUBLIC_API_URL=http://192.168.1.7:3333

# Cloudflare R2 public CDN (imagens/vídeos). Sem isso o app tenta /uploads na API (disco efêmero no Render).
# EXPO_PUBLIC_MEDIA_URL=https://pub-XXXX.r2.dev
# EXPO_PUBLIC_MEDIA_URL=https://media.edersonprogramador.com

# Google Maps (Android/iOS nativo via react-native-maps). Obrigatório para tiles Google no Android.
# Obtenha em https://console.cloud.google.com/ → Maps SDK for Android / iOS
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# GOOGLE_MAPS_API_KEY=AIza...

# Bridge GPS: expo (default) | bare
# EXPO_PUBLIC_TRACKING_BRIDGE=expo
